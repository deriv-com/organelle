{
  "name": "organelle",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx scripts/import/import-org.ts --file examples/demo-organization.csv --organization-name 'Organelle Demo' --apply && node --env-file-if-exists=.env --import tsx scripts/admin/bootstrap.ts --email admin@example.com",
    "org:import": "node --env-file-if-exists=.env --import tsx scripts/import/import-org.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/admin/bootstrap.ts",
    "admin:identity:reset": "node --env-file-if-exists=.env --import tsx scripts/admin/reset-identity.ts",
    "employees:reconcile": "node --env-file-if-exists=.env --import tsx scripts/employees/reconcile.ts",
    "check:references": "tsx scripts/check-public-references.ts",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "d3": "^7",
    "d3-flextree": "^2.1.2",
    "d3-org-chart": "^3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "^15.5.24",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postgres": "^3",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3",
    "zod": "^4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/d3": "^7",
    "@types/d3-flextree": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^26",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
